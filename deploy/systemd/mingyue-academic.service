[Unit]
Description=MingYue Academic Platform (/academic)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mingyue-academic/backend
EnvironmentFile=/etc/mingyue-academic.env
ExecStart=/opt/mingyue-academic/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mingyue-academic

[Install]
WantedBy=multi-user.target
