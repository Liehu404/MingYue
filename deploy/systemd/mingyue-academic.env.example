# /etc/mingyue-academic.env  (chmod 600, root:www-data)
# 复制本文件后替换 SECRET_KEY，切勿把真实值提交到 Git。

DATABASE_URL=sqlite+aiosqlite:////opt/mingyue-academic/data.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/opt/mingyue-academic/uploads

# 与主站（明月科创教育大模型）单点登录
SSO_ENABLED=true
MODEL_SESSION_URL=http://127.0.0.1:5002/get_session

# 部署在主站子路径
PUBLIC_BASE_PATH=/academic

# 知识库：新机没有 Canvas 隧道，默认关闭调度器
KB_SCHEDULER_ENABLED=false
KB_DATA_DIR=/opt/mingyue-academic/data_import
