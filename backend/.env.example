# 学术平台运行配置（复制为 .env 或由 systemd EnvironmentFile 提供）
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=./uploads

# 与主站（明月科创教育大模型）单点登录
SSO_ENABLED=true
MODEL_SESSION_URL=http://127.0.0.1:5002/get_session

# 部署在子路径时填写，例如 /academic；本地开发留空
PUBLIC_BASE_PATH=

# 知识库
KB_SCHEDULER_ENABLED=true
KB_DATA_DIR=/opt/mingyue/data_import
